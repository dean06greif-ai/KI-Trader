+def robustness_key(m: Optional[Dict]) -> tuple:
+    """Robustheits-Rang bei praktisch gleichem Score (Score-Gleichstand, z.B.
+    beide ~100): zuerst der Holdout (finaler Test auf UNANGETASTETEN Daten),
+    dann längere – also handelbarere – Live-Phasen, dann weniger Umschaltungen
+    (stabiler). Höher = robuster."""
+    if not m:
+        return (-1e9, -1e9, -1e9)
+    hold = m.get("holdout_direction_pct")
+    phase = m.get("avg_live_phase_days")
+    switches = m.get("switches_live")
+    return (float(hold) if hold is not None else -1.0,
+            float(phase) if phase is not None else -1.0,
+            -float(switches) if switches is not None else 0.0)
+
+
 def _mean(xs: List[float]) -> Optional[float]:
