+/* -------- Scroll-Trap-Fix (Bugfix 06/26): Auf Mobile gab es verschachtelte
+   Voll-Scroller (.app-layout mit overflow-y:auto aus extra.css und
+   .right-panel mit max-height:60vh + overflow-y:auto). Beim Hochscrollen
+   blieb die Seite darin "hängen" (iOS Rubber-Banding im inneren Scroller),
+   man musste vom oberen Bildschirmrand wischen. Fix: auf Mobile gibt es nur
+   EINEN Seiten-Scroller – die inneren Bereiche fließen im Seitenfluss mit.
+   Nur die Coin-Sidebar bleibt bewusst intern scrollbar (lange Coin-Liste). */
+@media (max-width: 968px) {
+  .app-layout {
+    overflow-y: visible;
+    height: auto;
+  }
+  .right-panel,
+  .performance-analytics {
+    max-height: none;
+    overflow-y: visible;
+  }
+  .coin-sidebar {
+    overscroll-behavior-y: contain; /* kein Rubber-Band-Übergriff auf die Seite */
+  }
+  .strategy-tabs-scroll {
+    overscroll-behavior-x: contain;
+  }
+}
