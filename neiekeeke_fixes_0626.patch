+# ---------- 2. Watchdog-Börsen-Sync (Margin/Hebel/Teilschließung) ----------
+
+def _watchdog(local):
+    wd = PositionWatchdog()
+    wd.db = FakeDB([local])
+    return wd
+
+
+def test_sync_local_state_mirrors_margin_leverage_partial_close():
+    local = {"id": "t1", "status": "open", "mode": "live", "symbol": "BTC",
+             "side": "LONG", "leverage": 10.0, "max_capital": 100.0,
+             "qty": 1.0, "qty_remaining": 1.0, "events": []}
+    pos = {"bitunix_symbol": "BTCUSDT", "side": "LONG", "qty": 0.5,
+           "entry": 100.0, "position_id": "p1", "leverage": 25.0, "margin": 40.0}
+    wd = _watchdog(local)
+    changed = run(wd._sync_local_state(local, pos, "BTC"))
+    assert changed is True
+    assert local["leverage"] == 25.0
+    assert local["max_capital"] == pytest.approx(40.0)
+    assert local["qty_remaining"] == pytest.approx(0.5)
+    assert local["bitunix_position_id"] == "p1"
+    assert any("BÖRSEN-SYNC" in e for e in local["events"])
+    assert len(wd.db.auto_trades.updates) == 1
+
+
+def test_sync_local_state_noop_when_unchanged():
+    local = {"id": "t1", "leverage": 20.0, "max_capital": 50.0,
+             "qty": 1.0, "qty_remaining": 1.0, "events": [],
+             "bitunix_position_id": "p1"}
+    pos = {"side": "LONG", "qty": 1.0, "position_id": "p1",
+           "leverage": 20.0, "margin": 50.2}  # 0.4% Abweichung -> kein Churn
+    wd = _watchdog(local)
+    assert run(wd._sync_local_state(local, pos, "BTC")) is False
+    assert wd.db.auto_trades.updates == []
+
+
+def test_sync_never_increases_qty():
+    """Manuelle Aufstockung (Börse > Website) darf qty NICHT hochziehen."""
+    local = {"id": "t1", "leverage": 10.0, "max_capital": 100.0,
+             "qty": 1.0, "qty_remaining": 1.0, "events": [],
+             "bitunix_position_id": "p1"}
+    pos = {"side": "LONG", "qty": 2.0, "position_id": "p1",
+           "leverage": 10.0, "margin": 100.0}
+    wd = _watchdog(local)
+    run(wd._sync_local_state(local, pos, "BTC"))
+    assert local["qty_remaining"] == pytest.approx(1.0)
+
