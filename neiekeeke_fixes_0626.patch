diff --git a/backend/tests/test_fix_capital_truth_and_sync.py b/backend/tests/test_fix_capital_truth_and_sync.py
new file mode 100644
index 0000000..cd36dd5
--- /dev/null
+++ b/backend/tests/test_fix_capital_truth_and_sync.py
@@ -0,0 +1,221 @@
+"""Regressionstests Fix 06/26 – drei Bug-Reports:
+
+1. KI Trader machte nur Datensammel-, aber keine Live-Trades mehr:
+   Ursache war das falsch berechnete freie Kapital. Die DB-Summe der
+   Trade-Margins (used_margin) wurde durch manuelle Margin-/Hebel-Änderungen
+   an der Börse ungültig -> scheinbar negatives freies Kapital.
+   Fix: `free_capital_status` nutzt für LIVE die Bitunix-API als Source of
+   Truth (echte Positions-Margin + echtes verfügbares Guthaben).
+2. Bitunix-Live-Anzeige: Margin reduzieren / Hebel erhöhen / Partial-TP an
+   der Börse kamen nicht auf der Website an.
+   Fix: Watchdog `_sync_local_state` spiegelt Margin/Hebel/Menge in die DB.
+3. Mobile-Scroll-Bug: verschachtelte Voll-Scroller entfernt (mobile.css).
+"""
+import asyncio
+from pathlib import Path
+
+import pytest
+
+from services.bitunix_trade import AutoTradeManager
+from services.position_watchdog import PositionWatchdog, parse_positions
+
+
+def run(coro):
+    return asyncio.run(coro)
+
+
+class FakeCursor:
+    def __init__(self, docs):
+        self._docs = docs
+
+    def __aiter__(self):
+        self._it = iter(self._docs)
+        return self
+
+    async def __anext__(self):
+        try:
+            return next(self._it)
+        except StopIteration:
+            raise StopAsyncIteration
+
+
+class FakeCollection:
+    def __init__(self, docs=None):
+        self.docs = docs or []
+        self.updates = []
+
+    def find(self, q):
+        return FakeCursor([d for d in self.docs
+                           if all(d.get(k) == v for k, v in q.items())])
+
+    async def update_one(self, q, upd, **kw):
+        self.updates.append((q, upd))
+        for d in self.docs:
+            if all(d.get(k) == v for k, v in q.items()):
+                d.update(upd.get("$set", {}))
+        return None
+
+
+class FakeDB:
+    def __init__(self, trades=None):
+        self.auto_trades = FakeCollection(trades or [])
+
+
+class FakeClient:
+    def __init__(self, configured=True, balance=None, positions=None,
+                 fail_balance=False, fail_positions=False):
+        self._configured = configured
+        self._balance = balance
+        self._positions = positions or []
+        self.fail_balance = fail_balance
+        self.fail_positions = fail_positions
+
+    def configured(self):
+        return self._configured
+
+    async def get_balance(self):
+        if self.fail_balance:
+            raise RuntimeError("api down")
+        return {"code": 0, "data": self._balance}
+
+    async def get_positions(self, symbol=None):
+        if self.fail_positions:
+            raise RuntimeError("api down")
+        return {"code": 0, "data": self._positions}
+
+
+def _manager(client, trades=None):
+    m = AutoTradeManager(client)
+    m.set_db(FakeDB(trades))
+    return m
+
+
+# ---------- 1. Freies Kapital: Bitunix als Source of Truth (LIVE) ----------
+
+def test_live_free_capital_uses_exchange_not_stale_db():
+    """Manuelle Margin-Reduktion an der Börse: DB sagt 400 USDT gebunden,
+    Börse nur 60 -> frei muss aus der Börse kommen, nicht aus der DB."""
+    client = FakeClient(
+        balance={"available": "500", "frozen": "0", "margin": "100"},
+        positions=[{"symbol": "BTCUSDT", "side": "BUY", "qty": "1",
+                    "avgOpenPrice": "100", "positionId": "p1",
+                    "leverage": "20", "margin": "60"}])
+    stale = {"status": "open", "mode": "live", "max_capital": 400.0, "id": "t1"}
+    m = _manager(client, [stale])
+    st = run(m.free_capital_status("live"))
+    assert st["source"] == "exchange"
+    assert st["used"] == pytest.approx(60.0)
+    assert st["available"] == pytest.approx(500.0)
+    # frei = min(zugewiesen(600) - 60, verfügbar 500) = 500 (nie -X aus der DB)
+    assert st["free"] == pytest.approx(500.0)
+    assert st["free"] > 0
+
+
+def test_live_free_capital_falls_back_to_account_margin():
+    """Positions-Endpoint down -> Konto-Margin der Börse als Fallback."""
+    client = FakeClient(
+        balance={"available": "300", "frozen": "0", "margin": "50"},
+        fail_positions=True)
