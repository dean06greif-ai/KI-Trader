@@ -436,6 +436,60 @@ def _uniq_clip(vals, lo, hi):
     return out
 
 
+def calibration_grid(detector: str, base: Dict, d: float) -> Dict[str, List[float]]:
+    """Suchraum je Erkennungs-Prinzip: NUR Parameter, die der gewählte
+    Detektor tatsächlich nutzt (vgl. eng.CONFIG_GROUPS). Vorher wurde immer
+    der Regressions-Suchraum durchlaufen – bei reactive/ema/kombi änderten
+    sich dadurch die Labels nicht und 'kalibriert' war wirkungslos."""
+    hold = {"min_hold_days": _uniq_clip([base["min_hold_days"], d * 0.006, d * 0.012,
+                                         d * 0.024, d * 0.045], 1.0, 30.0)}
+    phase = {"min_phase_days": _uniq_clip([base["min_phase_days"], 0.0, d * 0.006,
+                                           d * 0.012, d * 0.024], 0.0, 90.0)}
+    if detector == "regression":
+        return {
+            "smooth_days": _uniq_clip([base["smooth_days"], d * 0.002, d * 0.0055, d * 0.010], 0.1, 15.0),
+            "trend_t": _uniq_clip([base["trend_t"], 1.2, 1.6, 2.0, 2.5, 3.2], 0.5, 10.0),
+            "hysteresis": _uniq_clip([base["hysteresis"], 0.15, 0.3, 0.45], 0.0, 0.9),
+            "confirm_days": _uniq_clip([base["confirm_days"], d * 0.003, d * 0.008, d * 0.015], 0.25, 20.0),
+            **hold,
+            "adx_min": _uniq_clip([base["adx_min"], 10.0, 18.0, 25.0], 0.0, 60.0),
+            "confidence_min": _uniq_clip([base["confidence_min"], 0.45, 0.55, 0.65], 0.0, 0.95),
+        }
+    if detector == "ema":
+        return {
+            "ema_regime_days": _uniq_clip([base["ema_regime_days"], 5.0, 9.0, 14.0, 21.0], 2.0, 100.0),
+            "ema_regime_thr": _uniq_clip([base["ema_regime_thr"], 0.10, 0.18, 0.30, 0.45], 0.05, 1.0),
+            "ema_regime_smooth_days": _uniq_clip([base["ema_regime_smooth_days"], 0.5, 1.0, 2.0], 0.25, 10.0),
+            "ema_regime_persist_days": _uniq_clip([base["ema_regime_persist_days"], 0.5, 1.0, 2.0], 0.0, 30.0),
+            **phase, **hold,
+        }
+    if detector == "kombi":
+        return {
+            "kombi_ema_days": _uniq_clip([base["kombi_ema_days"], 9.0, 14.0, 21.0], 2.0, 100.0),
+            "kombi_thr": _uniq_clip([base["kombi_thr"], 0.10, 0.18, 0.30], 0.05, 1.0),
+            "kombi_slope_days": _uniq_clip([base["kombi_slope_days"], 3.0, 5.0, 8.0], 0.5, 20.0),
+            "kombi_persist_days": _uniq_clip([base["kombi_persist_days"], 0.5, 1.0, 2.0], 0.0, 30.0),
+            "kombi_dominance_days": _uniq_clip([base["kombi_dominance_days"], 0.0, 3.0, 6.0], 0.0, 15.0),
+            **phase, **hold,
+        }
+    return {  # reactive (Standard): Umkehrpunkte
+        "rev_atr_mult": _uniq_clip([base["rev_atr_mult"], 1.5, 2.0, 3.0, 4.0, 6.0], 0.5, 15.0),
+        "persist_candles": _uniq_clip([base["persist_candles"], 2, 3, 5, 8], 1, 20),
